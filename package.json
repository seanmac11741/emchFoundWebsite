{
  "dependencies": {
    "firebase": "^11.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "jsdom": "^29.0.2",
    "vitest": "^4.1.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "scripts": {
    "build": "webpack --mode=development",
    "build:prod": "NODE_ENV=production webpack --mode production",
    "dev": "trap 'kill 0' INT TERM EXIT; webpack --mode=development --watch & firebase serve & wait",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore,auth \"bun run test\""
  }
}