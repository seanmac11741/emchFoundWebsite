{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=900,no-cache"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-eval' apis.google.com *.googletagmanager.com *.fbcdn.net *.googleapis.com *.google-analytics.com; style-src 'self' 'unsafe-inline' *.googletagmanager.com *.fbcdn.net *.googleapis.com *.google-analytics.com; img-src 'self' *.googleapis.com; connect-src 'self' *.googleapis.com; font-src 'self' *.gstatic.com; manifest-src 'self'; frame-src 'self' www.facebook.com emchfoundation.firebaseapp.com"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}