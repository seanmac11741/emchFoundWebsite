{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "key": "Cache-Control",
        "value": "max-age=604800, public"
      },
      {
        "key": "Content-Security-Policy",
        "value": "default-src 'self' https: 'unsafe-inline' 'unsafe-style';"
      },
      {
        "key": "Strict-Transport-Security",
        "value": "enforce-origin-when-cross-origin; max-age=31536000;"
      },
      {
        "key": "X-Content-Type-Options",
        "value": "nosniff"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}